# Copy to docker/hermes/.env (git-ignored). Used only by scripts/setup-hermes.ps1 -Mode Fresh and `docker compose --env-file`.
# Adopt mode can instead read the legacy C:\laragon\jobsheet2\.env in place (never copied).
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Safe defaults: nothing can be sent from a fresh install.
JOYUMKM_ONBOARDING_LIVE_ENABLED=0
JOYUMKM_ONBOARDING_LIVE_RECIPIENT=
