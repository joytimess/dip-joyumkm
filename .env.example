APP_NAME=JoyUMKM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=joyumkm
DB_USERNAME=joyumkm
DB_PASSWORD=
DB_COLLATION=utf8mb4_0900_ai_ci
SANCTUM_TOKEN_EXPIRATION_DAYS=7
# Lokal saja; kosong berarti demo dilewati. Akun demo existing tidak direset.
DEMO_PASSWORD=
# Lokal saja; kosong berarti seeder contoh dilewati. Akun sample existing tidak direset.
SEED_PASSWORD=
# Profil data contoh: "small" (default, ~20 UMKM) atau "benchmark" (~1000 UMKM × 10 evaluasi).
SEED_PROFILE=small

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENWA_ENABLED=false
OPENWA_BASE_URL=
OPENWA_SESSION_ID=
OPENWA_API_KEY=
OPENWA_TIMEOUT_SECONDS=3

# Production wajib HTTPS + FQDN. Hanya APP_ENV=local/testing yang boleh http://127.0.0.1:8644/webhooks/joyumkm-events
# dengan HERMES_WEBHOOK_ALLOWED_HOST=127.0.0.1. Secret harus sama dengan subscription Hermes.
HERMES_WEBHOOK_ENABLED=false
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_ALLOWED_HOST=
HERMES_WEBHOOK_SECRET=
HERMES_WEBHOOK_TIMEOUT_SECONDS=5
HERMES_WEBHOOK_MAX_ATTEMPTS=5
HERMES_WEBHOOK_BACKOFF_BASE_SECONDS=30
HERMES_WEBHOOK_BACKOFF_CAP_SECONDS=900

# Callback laporan Intelligence (Hermes -> Laravel). Secret HARUS berbeda dari HERMES_WEBHOOK_SECRET, minimal 32 karakter.
# Kosong/pendek = endpoint menolak semua callback (fail-closed). Production wajib HTTPS.
HERMES_INTELLIGENCE_CALLBACK_SECRET=
HERMES_INTELLIGENCE_CALLBACK_TOLERANCE_SECONDS=300
# Pull snapshot historis P3-01 (Hermes -> Laravel, GET). Secret HARUS berbeda dari callback dan webhook, minimal 32 karakter.
HERMES_INTELLIGENCE_SNAPSHOT_SECRET=
HERMES_INTELLIGENCE_SNAPSHOT_TOLERANCE_SECONDS=300

# Unggah artefak PDF/XLSX (Hermes -> Laravel, PUT). Secret HARUS berbeda dari callback/webhook/snapshot, minimal 32 karakter acak.
HERMES_INTELLIGENCE_ARTIFACT_SECRET=
HERMES_INTELLIGENCE_ARTIFACT_TOLERANCE_SECONDS=300
INTELLIGENCE_PDF_PYTHON=python3
INTELLIGENCE_PDF_QPDF=qpdf

# Kunci HMAC fingerprint penerima email (minimal 32 karakter). Dipakai untuk suppression dan kelayakan penerima.
INTELLIGENCE_RECIPIENT_PEPPER=
HERMES_INTELLIGENCE_RECIPIENT_SECRET=
HERMES_INTELLIGENCE_RECIPIENT_TOLERANCE_SECONDS=300
INTELLIGENCE_RECIPIENT_TTL_SECONDS=60

GEOCODING_URL=
GEOCODING_ALLOWED_HOSTS=
GEOCODING_USER_AGENT=
GEOCODING_TIMEOUT_SECONDS=4
GEOCODING_CACHE_STORE=database
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

HERMES_INTELLIGENCE_DELIVERY_STATUS_SECRET=
HERMES_INTELLIGENCE_DELIVERY_STATUS_TOLERANCE_SECONDS=300
INTELLIGENCE_DELIVERY_STATUS_MESSAGE_DOMAIN=
